# GitHub secrets (set at least one script and one visual provider)
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional narration and CC0 ambient audio
HUME_API_KEY=
HUME_VOICE_ID=
FREESOUND_API_KEY=
# YouTube: trusted OAuth credential pickle from your own local authentication
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_PICKLE_BASE64=
# Meta secret: Facebook Login Page access token
META_ACCESS_TOKEN=
# Optional override; scheduled social workflow defaults to v24.0
META_GRAPH_API_VERSION=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Low-level local publishing only; scheduled workflow hosts images automatically
INSTAGRAM_IMAGE_URL=
# Optional local font path for social cards
SOCIAL_FONT=

# Preferred: User token is exchanged for a Page publishing token at runtime.
META_USER_TOKEN=
# Must be the Facebook Page ID, not your personal user ID.
FACEBOOK_ID=

# Only for local execution of scripts.social_automation; Actions provides these.
GITHUB_REPOSITORY=techwired-solutions/horror_story_youtube_automation
GITHUB_TOKEN=

# Optional model overrides (GitHub repository variables)
GEMINI_MODEL=gemini-3-flash-preview
NVIDIA_MODEL=

# Facebook default attaches the actual image. Optional: text or alternate.
SOCIAL_FACEBOOK_FORMAT=photo
