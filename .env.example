# GitHub secrets (set at least one script and one visual provider)
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional narration and CC0 ambient audio
HUME_API_KEY=
HUME_VOICE_ID=
FREESOUND_API_KEY=
# YouTube: trusted OAuth credential pickle from your own local authentication
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_PICKLE_BASE64=
# Meta secret: Facebook Login Page access token
META_ACCESS_TOKEN=
# GitHub repository variables; choose a currently supported Graph API version
META_GRAPH_API_VERSION=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# Local publishing only; Actions accepts this as an input
INSTAGRAM_IMAGE_URL=
# Optional local font path for social cards
SOCIAL_FONT=

# Preferred: User token is exchanged for a Page publishing token at runtime.
META_USER_TOKEN=
# Must be the Facebook Page ID, not your personal user ID.
FACEBOOK_ID=
